# Создай Telegram-бота через @BotFather и вставь сюда токен.
BOT_TOKEN=123456789:INSERT_YOUR_BOT_TOKEN_HERE
# Узнать свой ID можно через @userinfobot.
ADMIN_IDS=
DATABASE_PATH=data/minepulse.db
# Проверка сервера каждые 180 секунд. Минимум 60.
CHECK_INTERVAL=180
CHECK_CONCURRENCY=12
MAX_SERVERS_PER_USER=5
# Цена продвижения — Telegram Stars, НЕ рубли.
PROMO_STARS=50
PROMO_DAYS=7
